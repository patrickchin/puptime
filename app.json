{
  "expo": {
    "name": "Puptime",
    "slug": "puptime",
    "version": "1.1.0",
    "description": "One-tap puppy routine tracking from your app or home screen.",
    "scheme": "puptime",
    "icon": "./assets/puptime-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.patrickchin.puptime",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.patrickchin.puptime",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#176B52",
        "foregroundImage": "./assets/puptime-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PuptimeQuickLog",
              "label": "Puptime Quick Log",
              "description": "Log in one tap. Resize taller to backdate up to an hour.",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeHeight": "110dp",
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.patrickchin.puptime",
          "bundleIdentifier": "com.patrickchin.puptime.widget",
          "widgets": [
            {
              "name": "PuptimeQuickLog",
              "displayName": "Puptime Quick Log",
              "description": "Log now or backdate puppy activities by up to an hour.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "./plugins/withAndroidWorkManager"
    ]
  }
}
