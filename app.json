{
  "expo": {
    "name": "Puptime",
    "slug": "puptime",
    "version": "1.12.0",
    "description": "Log puppy activities from the app or Home Screen.",
    "scheme": "puptime",
    "icon": "./assets/puptime-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.patrickchin.puptime",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a photo for your dog’s profile."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.patrickchin.puptime",
      "versionCode": 1012000,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#176B52",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./public/social-preview.png",
      "output": "static"
    },
    "plugins": [
      "./plugins/withAndroidWidgetChronometer",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PuptimeQuickLog",
              "label": "Puptime · Quick log",
              "description": "Your activities in one full-width row.",
              "minWidth": "250dp",
              "minHeight": "56dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeHeight": "96dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "PuptimeActions",
              "label": "Puptime · All activities",
              "description": "Six quick-log buttons in two rows.",
              "minWidth": "250dp",
              "minHeight": "128dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "PuptimeOverview",
              "label": "Puptime · At a glance",
              "description": "Quick logs, a potty reminder, and nap or walk status.",
              "minWidth": "250dp",
              "minHeight": "128dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "PuptimeSingle",
              "label": "Puptime · Single button",
              "description": "Your first selected widget activity in one small tile.",
              "minWidth": "56dp",
              "minHeight": "56dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "PuptimePair",
              "label": "Puptime · Two buttons",
              "description": "Your first two selected widget activities.",
              "minWidth": "128dp",
              "minHeight": "56dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      "./plugins/withIosWidgetNotifications",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.patrickchin.puptime",
          "bundleIdentifier": "com.patrickchin.puptime.widget",
          "widgets": [
            {
              "name": "PuptimeQuickLog",
              "displayName": "Puptime Quick Log",
              "description": "Pick 2–4 activities to log from the Home Screen.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Puptime to use the microphone when you dictate a log note.",
          "speechRecognitionPermission": "Allow Puptime to turn dictated log notes into text."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#176B52",
          "defaultChannel": "puptime-routine"
        }
      ],
      "expo-font",
      "./plugins/withAndroidWorkManager",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Puptime to use the microphone when you dictate a log note.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.809758465510-jnjkvg56do270gbco4djj8s8l7fgsi9j"
        }
      ],
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-router",
        {
          "root": "./web"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your dog’s profile.",
          "cameraPermission": false,
          "microphonePermission": "Allow Puptime to use the microphone when you dictate a log note."
        }
      ]
    ],
    "owner": "patchin",
    "extra": {
      "eas": {
        "projectId": "00a097cd-d35d-47dd-8c9a-89e9b3bf8fa3"
      }
    }
  }
}
