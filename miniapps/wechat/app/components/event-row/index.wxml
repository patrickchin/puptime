<button class="row" hover-class="pressed" bindtap="edit" aria-label="{{editLabel}}: {{event.label}}, {{event.time}}">
  <view class="activity-icon {{event.type}}"><image src="/assets/{{event.type}}.png" aria-hidden="true" /></view>
  <view class="body"><text class="label">{{event.label}}</text><text class="time">{{event.time}} · {{sourceLabel}}</text><text wx:if="{{event.note}}" class="note">{{event.note}}</text></view>
  <text class="chevron" aria-hidden="true">›</text>
</button>
