:host { display: block; }
.row { display: flex; gap: 12px; align-items: center; width: 100% !important; min-height: 72px; padding: 10px 0 !important; text-align: left; background: white; border: 0; border-radius: 0; font: inherit; color: #17231E; line-height: 1.5; margin: 0 !important; }
.row::after { border: 0; }
.pressed { background: #EDEFE8; }
.activity-icon { width: 42px; height: 42px; flex: 0 0 42px; border-radius: 15px; background: #DDF2FA; display: flex; align-items: center; justify-content: center; }
.activity-icon image { width: 22px; height: 22px; }
.poop { background: #FFF0DC; } .meal { background: #E8F4DF; }
.body { flex: 1; min-width: 0; }
.label { display: block; font-size: 16px; font-weight: 600; }
.note { display: block; color: #56635D; font-size: 13px; white-space: pre-wrap; overflow-wrap: anywhere; }
.time { display: block; font-size: 12px; line-height: 17px; margin-top: 2px; color: #56635D; font-variant-numeric: tabular-nums; }
.chevron { font-size: 22px; color: #56635D; }
