.profile { display: flex; align-items: center; justify-content: space-between; min-height: 48px; margin-bottom: 20px; }
.settings-button { display: flex; align-items: center; justify-content: center; width: 48px !important; height: 48px; margin: 0 !important; flex: 0 0 48px; background: var(--surface); border: 1px solid var(--line); }
.settings-button image { width: 23px; height: 23px; }
/* Match the native app's 112px QuickActions cards and 8px grid gap. */
.quick-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.quick { width: 100% !important; min-width: 0; min-height: 112px; padding: 12px 4px; text-align: center; background: white; border: 1px solid var(--line); border-radius: 22px; line-height: 1.4; }
.quick-name { font-size: 15px; font-weight: 700; margin-top: 7px; line-height: 20px; }
.last { font-size: 11px; line-height: 16px; margin-top: 1px; color: var(--muted); }
.activity-icon { display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 15px; margin: 0 auto; background: #DDF2FA; }
.activity-icon image { width: 25px; height: 25px; }
.poop .activity-icon { background: #FFF0DC; } .meal .activity-icon { background: #E8F4DF; }
.day { margin-bottom: 8px; background: white; }
.day-title { display: flex; gap: 10px; align-items: center; min-height: 52px; padding: 0 14px; font-size: 15px; font-weight: 700; color: var(--green); border-bottom: 1px solid var(--line); }
.day-title > text:first-child { flex: 1; }
.day-count { color: var(--muted); font-size: 13px; font-weight: 700; }
.day-rows { padding: 0 14px; }
.event-wrap + .event-wrap { border-top: 1px solid var(--line); }
.empty { padding: 32px 20px; text-align: center; }
.empty-title { font-size: 18px; font-weight: 650; margin-bottom: 6px; }
.more { width: 100%; }
.toast { position: fixed; bottom: 18px; left: 20px; right: 20px; display: flex; align-items: center; justify-content: space-between; min-height: 56px; padding: 0 8px 0 20px; background: var(--ink); color: white; border-radius: 16px; z-index: 3; }
.undo-button { width: auto !important; color: #A3E4C7; padding: 12px 16px; min-height: 48px; }
.scrim { position: fixed; inset: 0; background: rgba(12, 24, 18, .5); z-index: 10; display: flex; align-items: flex-end; }
.sheet { background: var(--surface); border-radius: 24px 24px 0 0; width: 100%; padding: 12px 20px calc(20px + env(safe-area-inset-bottom)); }
.sheet-heading { display: flex; align-items: center; justify-content: space-between; }
.editor-body { max-height: 54vh; }
.date-fields { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12px; }
.note-input { height: 100px; }
.picker-arrow { float: right; color: var(--muted); }
.delete { color: var(--danger); font-size: 14px; min-height: 48px; width: 100% !important; text-align: left; padding: 12px 0; margin: 4px 0 12px; }
