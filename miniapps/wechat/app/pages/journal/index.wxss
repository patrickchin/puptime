.profile { display: flex; align-items: center; gap: 12px; min-height: 80px; }
.puppy { width: 66px; height: 76px; flex-shrink: 0; }
.profile-title { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.profile .plain-button { width: auto !important; flex: 0 0 auto; padding-right: 0; }
.first { margin-top: 24px; }
/* At 375px: 335px content = 3 × 105px actions + 2 × 10px gaps. */
.quick-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.quick { width: 100% !important; min-width: 0; min-height: 190px; padding: 16px 4px 14px; text-align: center; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; line-height: 1.4; }
.quick-count { font-size: 28px; font-weight: 650; font-variant-numeric: tabular-nums; margin: 4px 0; }
.quick-name { font-size: 17px; font-weight: 650; }
.last { font-size: 12px; color: var(--muted); }
.art { position: relative; overflow: hidden; width: 56px; height: 56px; margin: 0 auto 8px; }
.atlas { position: absolute; width: 168px; height: 56px; max-width: none; left: 0; top: 0; }
.art-poop .atlas { left: -56px; } .art-meal .atlas { left: -112px; }
.day { margin-bottom: 20px; }
.day-title { display: flex; gap: 10px; align-items: baseline; font-size: 14px; font-weight: 650; margin: 0 4px 10px; }
.day-count { color: var(--muted); font-size: 12px; font-weight: 400; }
.event-wrap + .event-wrap { border-top: 1px solid var(--line); }
.empty { padding: 32px 20px; text-align: center; }
.empty-title { font-size: 18px; font-weight: 650; margin-bottom: 6px; }
.more { width: 100%; }
.toast { position: fixed; bottom: 18px; left: 20px; right: 20px; display: flex; align-items: center; justify-content: space-between; min-height: 56px; padding: 0 8px 0 20px; background: var(--ink); color: white; border-radius: 16px; z-index: 3; }
.undo-button { width: auto !important; color: #A3E4C7; padding: 12px 16px; min-height: 48px; }
.scrim { position: fixed; inset: 0; background: rgba(12, 24, 18, .5); z-index: 10; display: flex; align-items: flex-end; }
.sheet { background: var(--surface); border-radius: 24px 24px 0 0; width: 100%; padding: 12px 20px calc(20px + env(safe-area-inset-bottom)); }
.sheet-heading { display: flex; align-items: center; justify-content: space-between; }
.editor-body { max-height: 54vh; }
.date-fields { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12px; }
.note-input { height: 100px; }
.picker-arrow { float: right; color: var(--muted); }
.delete { color: var(--danger); font-size: 14px; min-height: 48px; width: 100% !important; text-align: left; padding: 12px 0; margin: 4px 0 12px; }
