page { overflow: hidden; }
.filters { display: flex; gap: 8px; padding: 8px 16px; border-bottom: 1px solid var(--line); height: 72px; align-items: center; }
.filter { flex: 1; width: auto !important; margin: 0 !important; display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 48px; padding: 0 10px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); color: var(--muted); font-size: 12px; font-weight: 700; }
.filter image { width: 17px; height: 17px; }
.active-pee { background: #DDF2FA; border-color: #086B9B; color: #086B9B; }
.active-combined { background: var(--green-soft); border-color: var(--green); color: var(--green); }
.check { width: 14px; }
.axis { height: 30px; display: flex; border-bottom: 1px solid var(--line); }
.date-axis { width: 56px; flex-shrink: 0; border-right: 1px solid var(--line); }
.axis-track { position: relative; flex: 1; margin-right: 1px; }
.hour { position: absolute; bottom: 4px; font-size: 10px; font-weight: 600; color: var(--muted); transform: translateX(-50%); }
.hour.start-hour { transform: none; }.hour.end-hour { transform: translateX(-100%); }
.timeline-day { display: flex; height: 52px; }
.today-row { background: var(--green-soft); }
.date-cell { width: 56px; flex: 0 0 56px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 0 6px; display: flex; flex-direction: column; justify-content: center; }
.weekday { font-size: 10px; line-height: 13px; font-weight: 800; }
.today-row .weekday { color: var(--green); }
.date { font-size: 10px; line-height: 13px; font-weight: 600; margin-top: 1px; color: var(--muted); }
.track { position: relative; flex: 1; overflow: hidden; background: var(--surface); border-bottom: 1px solid var(--line); }
.today-row .track { background: var(--green-soft); }
.grid-line { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--line); }
.grid-line.major { background: #BBC3BD; }
.mark { position: absolute; top: 3px; bottom: 3px; width: 6px; margin-left: -3px; border-radius: 999px; overflow: hidden; display: flex; flex-direction: column; }
.mark-part { flex: 1; }.pee { background: #086B9B; }.poop { background: #B54E00; }.meal { background: #3B7827; }
.now { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--green); }
.earlier { width: 100% !important; min-height: 48px; font-size: 13px; color: var(--green); }
.timeline-clearance { height: calc(100px + env(safe-area-inset-bottom)); }
.detail-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.42); z-index: 10; display: flex; align-items: flex-end; }
.details { width: 100%; background: white; border-radius: 28px 28px 0 0; padding: 16px 20px calc(24px + env(safe-area-inset-bottom)); }
.details-heading { display: flex; align-items: center; justify-content: space-between; font-size: 20px; font-weight: 800; }
.close { width: 48px !important; height: 48px; margin: 0 !important; display: flex; align-items: center; justify-content: center; }.close image { width: 22px; height: 22px; }
.details-list { max-height: 45vh; }
.detail-row { display: flex; align-items: center; gap: 12px; width: 100% !important; padding: 14px 0; border-radius: 0; min-height: 64px; text-align: left; font-size: 16px; }
.detail-row + .detail-row { border-top: 1px solid var(--line); }.detail-row image { width: 24px; height: 24px; }.detail-copy { flex: 1; }.detail-row .edit-icon { width: 20px; height: 20px; }.detail-note { margin-top: 4px; font-size: 13px; color: var(--muted); }
