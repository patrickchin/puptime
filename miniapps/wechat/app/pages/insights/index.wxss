.headline { display: flex; align-items: baseline; gap: 10px; margin: 28px 0 20px; flex-wrap: wrap; }
.total { font-size: 38px; font-weight: 650; font-variant-numeric: tabular-nums; }
.active { font-size: 13px; color: var(--muted); margin-left: auto; }
.totals { display: flex; }
.stat { flex: 1; padding: 18px 8px; text-align: center; }
.stat + .stat { border-left: 1px solid var(--line); }
.stat-label { font-size: 14px; color: var(--muted); }
.stat-value { font-size: 26px; font-weight: 600; margin: 4px 0; font-variant-numeric: tabular-nums; }
.stat .subtitle { font-size: 12px; }
.chart-panel { padding: 20px 12px; }
.legend { display: flex; justify-content: flex-start; gap: 20px; margin: 0 8px 24px; font-size: 13px; }
.legend view { display: flex; align-items: center; gap: 7px; }
.dot { width: 8px; height: 8px; border-radius: 50%; }
.pee { background: #086B9B; } .poop { background: #B54E00; } .meal { background: #3B7827; }
.chart { display: flex; justify-content: space-around; gap: 4px; }
.column { flex: 1; min-width: 0; text-align: center; }
.bar-value { display: block; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
.bar-track { height: 132px; display: flex; align-items: flex-end; justify-content: center; border-bottom: 1px solid var(--line); padding-bottom: 0; }
.bar { width: 22px; }
.bar view { width: 100%; }
.bar-date { font-size: 11px; color: var(--muted); display: block; margin-top: 10px; }
.chart-empty { margin: 20px 4px 0; }
