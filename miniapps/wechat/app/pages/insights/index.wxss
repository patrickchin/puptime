.insights-page { max-width: 760px; padding-bottom: calc(32px + env(safe-area-inset-bottom)); }
.insight-section { border-top: 1px solid var(--line); padding-top: 16px; }
.section-heading { display: flex; align-items: center; gap: 10px; padding: 4px; }
.section-icon { width: 21px; height: 21px; margin: 9px 3px; flex-shrink: 0; }
.panel-title { font-size: 18px; line-height: 23px; font-weight: 700; }
.caption { font-size: 12px; line-height: 17px; margin-top: 1px; color: var(--muted); }
.frequency-row { border-top: 1px solid var(--line); padding: 13px 4px 11px; margin-top: 12px; }
.activity-heading { display: flex; align-items: center; gap: 9px; margin-bottom: 11px; }
.activity-icon { width: 38px; height: 38px; border-radius: 15px; background: #DDF2FA; display: flex; align-items: center; justify-content: center; }
.activity-icon image { width: 20px; height: 20px; }
.activity-icon.poop { background: #FFF0DC; }
.activity-name { flex: 1; font-size: 16px; line-height: 21px; font-weight: 800; }
.log-count { font-size: 12px; line-height: 17px; font-weight: 600; color: var(--muted); }
.metrics { display: flex; align-items: stretch; }
.metric { flex: 1; min-width: 0; padding: 0 6px; }
.divider { width: 1px; margin: 0 6px; background: var(--line); }
.metric-value { font-size: 21px; line-height: 27px; font-weight: 800; font-variant-numeric: tabular-nums; }
.metric-detail { font-size: 11px; line-height: 16px; margin-top: 4px; color: var(--muted); }
.metric-label { font-size: 10px; line-height: 13px; font-weight: 800; margin-top: 2px; color: var(--muted); }
.months-section { margin-top: 16px; }
.month { border-top: 1px solid var(--line); padding: 11px 8px; }
.current-month { background: var(--green-soft); }
.month-heading { display: flex; justify-content: space-between; gap: 8px; font-size: 14px; line-height: 20px; font-weight: 700; }
.current-month .month-heading { color: var(--green); }
.month-track { height: 7px; border-radius: 4px; overflow: hidden; background: var(--surface); margin: 7px 0 5px; }
.month-bar { height: 7px; border-radius: 4px; background: var(--green); }
.months-toggle { width: 100% !important; }
