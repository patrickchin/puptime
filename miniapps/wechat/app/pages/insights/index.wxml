<page-shell screen="insights" />
<view class="page insights-page">
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:else>
    <view class="insight-section">
      <view class="section-heading"><image class="section-icon" src="/assets/timer.png" aria-hidden="true" /><view><view class="panel-title">{{t.frequency}}</view><view class="caption">{{caption}}</view></view></view>
      <view wx:for="{{stats}}" wx:key="type" class="frequency-row">
        <view class="activity-heading"><view class="activity-icon {{item.type}}"><image src="/assets/{{item.type}}.png" aria-hidden="true" /></view><text class="activity-name">{{item.label}}</text><text class="log-count">{{item.total}} {{t.logs}}</text></view>
        <view class="metrics"><view class="metric"><view class="metric-value">{{item.daily}}</view><view class="metric-detail">{{item.detail}}</view></view><view class="divider"></view><view class="metric"><view class="metric-value">{{item.gap}}</view><view class="metric-label">{{t.typicalGap}}</view><view class="metric-detail">{{item.gapDetail}}</view></view></view>
      </view>
    </view>
    <view wx:if="{{hasMonths}}" class="insight-section months-section">
      <view class="section-heading"><image class="section-icon" src="/assets/calendar.png" aria-hidden="true" /><view class="panel-title">{{t.byMonth}}</view></view>
      <view wx:for="{{months}}" wx:key="key" class="month {{item.current ? 'current-month' : ''}}"><view class="month-heading"><text>{{item.label}}</text><text>{{item.daily}}{{t.dailySuffix}}</text></view><view class="month-track"><view style="width: {{item.width}}%" class="month-bar"></view></view><view class="caption">{{item.total}} {{t.logs}} · {{item.days}} {{t.days}}</view></view>
      <button wx:if="{{hasMoreMonths}}" class="plain-button months-toggle" bindtap="toggleMonths">{{allMonths ? t.recentMonths : t.allMonths}}</button>
    </view>
  </block>
</view>
