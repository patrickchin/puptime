<view class="page">
  <view wx:if="{{demo}}" class="demo">{{t.demo}}</view>
  <view class="subtitle">{{name}}</view><view class="title">{{t.sevenDays}}</view><view class="subtitle">{{t.statsBody}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:else>
    <view class="headline"><text class="total">{{total}}</text><text class="muted">{{t.total}}</text><text class="active">{{activeDays}} {{t.days}}</text></view>
    <view class="panel totals"><view wx:for="{{totals}}" wx:key="type" class="stat"><view class="stat-label">{{t[item.type]}}</view><view class="stat-value">{{item.count}}</view><view class="subtitle">{{item.average}} {{t.perDay}}</view></view></view>
    <view class="section-head"><text class="heading">{{t.activityByDay}}</text></view>
    <view class="panel chart-panel">
      <view class="legend"><view><text class="dot pee"></text>{{t.pee}}</view><view><text class="dot poop"></text>{{t.poop}}</view><view><text class="dot meal"></text>{{t.meal}}</view></view>
      <view class="chart"><view wx:for="{{days}}" wx:key="key" class="column" aria-label="{{item.key}}: {{t.pee}} {{item.pee}}, {{t.poop}} {{item.poop}}, {{t.meal}} {{item.meal}}">
        <text class="bar-value">{{item.total}}</text><view class="bar-track"><view class="bar"><view class="meal" style="height: {{item.mealHeight}}px"></view><view class="poop" style="height: {{item.poopHeight}}px"></view><view class="pee" style="height: {{item.peeHeight}}px"></view></view></view><text class="bar-date">{{item.label}}</text>
      </view></view>
      <view wx:if="{{!total}}" class="chart-empty subtitle">{{t.statsEmpty}}</view>
    </view>
  </block>
  <view class="notice">{{t.local}}</view>
</view>
