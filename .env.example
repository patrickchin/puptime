# Public browser configuration. Never put a PostHog personal API key here.
# Set the Puptime project token only in the production build environment.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional native product analytics. Separate build key keeps previews off.
# Use a public PostHog project token, never a personal API key.
EXPO_PUBLIC_APP_POSTHOG_KEY=
EXPO_PUBLIC_APP_POSTHOG_HOST=https://eu.i.posthog.com

# Public native account service. Override in .env.local for local Debug testing.
EXPO_PUBLIC_CLOUD_API_URL=https://puptime.pages.dev
