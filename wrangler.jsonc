{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puptime-api-staging",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "AccountStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-account-records",
      "new_sqlite_classes": [
        "AccountStore"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "puptime-auth-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "server/migrations"
    }
  ]
}
