{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "puptime-api-staging",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "AccountStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-account-records",
      "new_sqlite_classes": [
        "AccountStore"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "puptime-auth-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "server/migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "puptime-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "AUTH_BASE_URL": "https://puptime.pages.dev",
        "WEB_ORIGINS": "https://puptime.pages.dev",
        "CLOUD_TRIAL_DAYS": "14",
        "ACCOUNT_JURISDICTION": "eu"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ACCOUNTS",
            "class_name": "AccountStore"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "puptime-auth-staging",
          "database_id": "7b196976-caa3-4328-938f-822163ff9e06",
          "migrations_dir": "server/migrations"
        }
      ]
    }
  }
}
