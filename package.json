  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --clear --platform web --output-dir dist-web && node scripts/build-web-seo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/*.test.ts src/cloud/*.test.ts src/local/*.test.ts",
    "test:e2e:ios": "maestro test --platform ios --config .maestro/config.yaml .maestro",
    "prebuild": "expo prebuild",
    "build:android": "cd android && ./gradlew assembleRelease",
    "test:server": "vitest run --config server/vitest.config.mts",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "dev:server": "wrangler dev",
    "test:web": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/web/*.test.ts"
  },
  "private": true
}
