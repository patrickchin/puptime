  "main": "index.ts",
  "dependencies": {
    "@expo/ui": "~57.0.19",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "~57.0.20",
    "expo-sharing": "~57.0.21",
    "expo-speech-recognition": "^57.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-widgets": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist-web",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/*.test.ts src/cloud/*.test.ts",
    "test:e2e:ios": "maestro test --platform ios --config .maestro/config.yaml .maestro",
    "prebuild": "expo prebuild",
    "build:android": "cd android && ./gradlew assembleRelease",
    "test:server": "vitest run --config server/vitest.config.mts",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "dev:server": "wrangler dev"
  },
  "private": true
}
