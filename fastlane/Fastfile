default_platform(:ios)

platform :ios do
  private_lane :connect_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH")
    )
  end

  desc "Upload App Store metadata, screenshots, pricing, and availability"
  lane :metadata do
    deliver(
      api_key: connect_api_key,
      app_identifier: "com.patrickchin.puptime",
      app_version: "1.11.0",
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: true,
      price_tier: 0,
      overwrite_screenshots: true,
      force: true
    )
  end

  desc "Select build 17 and submit version 1.11.0 for App Review"
  lane :submit do
    deliver(
      api_key: connect_api_key,
      app_identifier: "com.patrickchin.puptime",
      app_version: "1.11.0",
      build_number: "17",
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      app_review_information: {
        first_name: ENV.fetch("APP_REVIEW_FIRST_NAME", "Patrick"),
        last_name: ENV.fetch("APP_REVIEW_LAST_NAME", "Chin"),
        email_address: ENV.fetch("APP_REVIEW_EMAIL"),
        phone_number: ENV.fetch("APP_REVIEW_PHONE"),
        notes: File.read("./fastlane/metadata/review_information/notes.txt")
      },
      submission_information: {
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end

