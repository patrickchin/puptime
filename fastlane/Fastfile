require "json"

PUPTIME_APP_VERSION = JSON.parse(File.read(File.expand_path("../app.json", __dir__))).fetch("expo").fetch("version")

default_platform(:ios)

platform :ios do
  private_lane :connect_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH")
    )
  end

  desc "Upload candidate App Store metadata and screenshots without submitting"
  lane :metadata do
    # Local features are free. Cloud plan prices are configured separately before release.
    deliver(
      api_key: connect_api_key,
      app_identifier: "com.patrickchin.puptime",
      app_version: PUPTIME_APP_VERSION,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      overwrite_screenshots: false,
      force: true
    )
  end

  desc "Submit the verified APP_STORE_BUILD_NUMBER for the app.json version to App Review"
  lane :submit do
    build_number = ENV.fetch("APP_STORE_BUILD_NUMBER").strip
    UI.user_error!("APP_STORE_BUILD_NUMBER must identify the verified uploaded build") if build_number.empty?

    deliver(
      api_key: connect_api_key,
      app_identifier: "com.patrickchin.puptime",
      app_version: PUPTIME_APP_VERSION,
      build_number: build_number,
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      app_review_information: {
        first_name: ENV.fetch("APP_REVIEW_FIRST_NAME", "Patrick"),
        last_name: ENV.fetch("APP_REVIEW_LAST_NAME", "Chin"),
        email_address: ENV.fetch("APP_REVIEW_EMAIL"),
        phone_number: ENV.fetch("APP_REVIEW_PHONE"),
        notes: File.read("./fastlane/metadata/review_information/notes.txt")
      },
      submission_information: {
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
